[Unit]
Description=Devi - actualiza el servidor desde la última release de GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Como root: instala el binario (de root) y reinicia devi-server. El binario nuevo se prueba como devi (runuser).
ExecStart=/opt/devi/devi-update.sh
Nice=10
IOSchedulingClass=idle

{
  "name": "devi",
  "version": "1.0.0",
  "description": "Devi: conecta las sesiones de Claude Code de tu equipo (solicitudes, respuestas y archivos con autorización humana)",
  "author": {
    "name": "Devi"
  },
  "mcpServers": {
    "devi": {
      "command": "devi",
      "args": [
        "mcp"
      ]
    }
  },
  "channels": [
    {
      "server": "devi",
      "displayName": "Devi"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devi",
            "args": [
              "hook",
              "start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devi",
            "args": [
              "hook",
              "working"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devi",
            "args": [
              "hook",
              "idle"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

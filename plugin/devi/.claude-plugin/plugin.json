{
  "name": "devi",
  "displayName": "Devi",
  "version": "0.4.0",
  "description": "Devi: conecta las sesiones de Claude Code de tu equipo (solicitudes, respuestas y archivos con autorización humana)",
  "author": {
    "name": "Dayan Cabrera",
    "url": "https://github.com/DayanCabrera2003"
  },
  "homepage": "https://github.com/DayanCabrera2003/devi",
  "repository": "https://github.com/DayanCabrera2003/devi",
  "keywords": [
    "equipo",
    "solicitudes",
    "permisos",
    "revisiones",
    "mcp",
    "canal"
  ],
  "mcpServers": {
    "devi": {
      "command": "devi",
      "args": [
        "mcp"
      ]
    }
  },
  "channels": [
    {
      "server": "devi",
      "displayName": "Devi"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devi",
            "args": [
              "hook",
              "start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devi",
            "args": [
              "hook",
              "working"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devi",
            "args": [
              "hook",
              "idle"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

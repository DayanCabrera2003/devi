{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devi",
  "version": "../package.json",
  "identifier": "app.devi.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Devi",
        "width": 560,
        "height": 740,
        "minWidth": 300,
        "minHeight": 380,
        "center": true,
        "visible": true
      },
      {
        "label": "mascota",
        "title": "Devi",
        "width": 132,
        "height": 168,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.ts.net http://127.0.0.1:4747 http://localhost:4747; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.ts.net http://127.0.0.1:4747 http://localhost:4747 ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["../../../dist/bin/devi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "devi",
  "version": "0.2.0",
  "description": "Devi: la mascota que conecta las sesiones de Claude Code de un equipo",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "server": "bun packages/server/src/main.ts",
    "server:dev": "bun packages/server/src/main.ts --dev",
    "test": "bun test packages/ scripts/",
    "typecheck": "bunx tsc -p packages/protocol && bunx tsc -p packages/server && bunx tsc -p packages/client && bunx tsc -p packages/cli",
    "devi": "bun packages/cli/src/main.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "build:devi": "bun scripts/build-cli.ts --target"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}

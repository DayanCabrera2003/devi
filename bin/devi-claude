#!/usr/bin/env bash
# Lanza Claude Code conectado a Devi como <user>, con una sesión llamada <session>.
# Uso: bin/devi-claude --user maria --session backend-api [-- <args extra de claude>]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
USER_ID=""
SESSION_NAME=""
EXTRA=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --user) USER_ID="${2:-}"; shift 2 ;;
    --session) SESSION_NAME="${2:-}"; shift 2 ;;
    --) shift; EXTRA=("$@"); break ;;
    *) echo "Argumento desconocido: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$USER_ID" || -z "$SESSION_NAME" ]]; then
  echo "Uso: bin/devi-claude --user <id> --session <nombre> [-- args de claude]" >&2
  exit 1
fi

if ! bun -e "const t=await Bun.file('$ROOT/team.json').json(); process.exit(t.some(m=>m.id==='$USER_ID')?0:1)"; then
  echo "\"$USER_ID\" no está en team.json" >&2
  exit 1
fi

export DEVI_USER="$USER_ID"
export DEVI_SESSION="$SESSION_NAME"
export DEVI_HUB_URL="${DEVI_HUB_URL:-http://localhost:4747}"
export DEVI_ROOT="$ROOT"

# Los development channels solo reconocen servidores MCP configurados (no los de --mcp-config),
# así que registramos "devi" en el scope local de la carpeta actual si aún no está.
if ! claude mcp get devi >/dev/null 2>&1; then
  claude mcp add devi --scope local -- bun "$ROOT/src/mcp/devi-channel.ts" >/dev/null
fi

# La config de hooks lleva __DEVI_ROOT__; se resuelve a rutas absolutas en un directorio temporal.
TMP="$(mktemp -d "${TMPDIR:-/tmp}/devi.XXXXXX")"
sed "s|__DEVI_ROOT__|$ROOT|g" "$ROOT/config/devi.settings.json" > "$TMP/settings.json"

exec claude \
  --settings "$TMP/settings.json" \
  --name "$SESSION_NAME" \
  --dangerously-load-development-channels server:devi \
  "${EXTRA[@]}"
